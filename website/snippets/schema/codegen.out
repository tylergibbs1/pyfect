from pyfect import schema as S

type UsernameType = str

Username = S.String.check(S.is_min_length(3).annotate(expected="a value with a length of at least 3"))

type AgeType = float

Age = S.Number.check(S.is_int().annotate(expected="an integer"))

from dataclasses import dataclass

@dataclass
class Point:
    """A point."""
    x: float
    y: float

ORIGIN = Point(0.0, 0.0)

