{
  "schema": {
    "$ref": "#/$defs/SignupEncoded"
  },
  "definitions": {
    "SignupEncoded": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20
        },
        "age": {
          "type": "integer",
          "minimum": 13,
          "maximum": 9007199254740991
        },
        "referrer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "username",
        "age"
      ],
      "additionalProperties": true
    }
  }
}
