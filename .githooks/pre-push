#!/usr/bin/env bash
# Formats, lints and type-checks the Python files a push changes, so a mistake ruff or pyright
# would catch fails here in seconds instead of in CI. CI still runs the full check on everything.
# scripts/install-hooks points core.hooksPath here; `git push --no-verify` skips it.
set -euo pipefail

zero=0000000000000000000000000000000000000000
changed=$(mktemp)
trap 'command rm -f "$changed"' EXIT
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # a deleted branch
  if [ "$remote_sha" = "$zero" ]; then
    # A new branch: what it adds to main.
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
  else
    base=$remote_sha
  fi
  if [ -n "$base" ] && git cat-file -e "$base^{commit}" 2>/dev/null; then
    git diff --name-only --diff-filter=ACMR "$base" "$local_sha" -- '*.py' ':!research/' >>"$changed"
  else
    git ls-tree -r --name-only "$local_sha" -- '*.py' ':!research/' >>"$changed"
  fi
done

files=()
while IFS= read -r file; do
  [ -f "$file" ] && files+=("$file")
done < <(sort -u "$changed")
[ ${#files[@]} -eq 0 ] && exit 0

run() { uv run --frozen --quiet "$@"; }
run ruff format --check "${files[@]}"
run ruff check "${files[@]}"
run pyright "${files[@]}"
